@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(@RULE_ENGINE_CONFIG_NEEDS_OPENSSL@)
    find_dependency(OpenSSL 3 COMPONENTS SSL Crypto)
endif()
if(@RULE_ENGINE_CONFIG_NEEDS_POSTGRESQL@)
    find_dependency(PostgreSQL 17)
endif()
if(@RULE_ENGINE_CONFIG_NEEDS_RE2@)
    find_dependency(re2 CONFIG)
endif()
if(@RULE_ENGINE_CONFIG_NEEDS_SQLITE@)
    find_dependency(SQLite3)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/rule_engineTargets.cmake")

set_and_check(rule_engine_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
set_and_check(rule_engine_PYTHON_SDK_DIR "@PACKAGE_RULE_ENGINE_CONFIG_PYTHON_SDK_DIR@")
set_and_check(rule_engine_PYTHON_WORKER "@PACKAGE_RULE_ENGINE_CONFIG_WORKER_FILE@")
set_and_check(rule_engine_DOCUMENTATION_DIR "@PACKAGE_RULE_ENGINE_CONFIG_DOC_DIR@")
set_and_check(rule_engine_EXAMPLES_DIR "@PACKAGE_RULE_ENGINE_CONFIG_EXAMPLE_DIR@")
set(rule_engine_PRIVATE_PYTHON_BUNDLED @RULE_ENGINE_CONFIG_PRIVATE_PYTHON_BUNDLED@)
if(rule_engine_PRIVATE_PYTHON_BUNDLED)
    set_and_check(rule_engine_PRIVATE_PYTHON_ROOT "@PACKAGE_RULE_ENGINE_CONFIG_PRIVATE_PYTHON_DIR@")
else()
    set(rule_engine_PRIVATE_PYTHON_ROOT "")
endif()

set(rule_engine_AVAILABLE_COMPONENTS "@RULE_ENGINE_CONFIG_AVAILABLE_COMPONENTS@")
foreach(component IN LISTS rule_engine_AVAILABLE_COMPONENTS)
    if(TARGET "rule_engine::${component}")
        set("rule_engine_${component}_FOUND" TRUE)
    else()
        set("rule_engine_${component}_FOUND" FALSE)
    endif()
endforeach()

check_required_components(rule_engine)
